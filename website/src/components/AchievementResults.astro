---
import EvidenceMix from './EvidenceMix.astro';
import type { Challenge } from '../lib/challenges';
import { achievementLetters } from '../lib/achievement-page';
import { sitePath } from '../lib/site';
import type { listProfiles } from '../lib/records';

interface Props {
  challenge: Challenge;
  people: ReturnType<typeof listProfiles>;
  letter?: string;
}

const { challenge, people, letter } = Astro.props;
const letters = achievementLetters(challenge.slug);
const selectedLetter = (letter || letters[0] || '').toLocaleUpperCase();
const letterPeople = people.filter((person) => person.name.trim().charAt(0).toLocaleUpperCase() === selectedLetter);
const letterUrl = (value: string) => sitePath(`/achievements/${challenge.slug}/${value.toLocaleLowerCase()}/`);
---

<div class="challenge-detail-intro">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href={sitePath('/achievements/')}>Achievements</a><span>/</span><span>{challenge.title}</span></nav>
  <span class="section-kicker">POVS Achievement</span>
  <div class="challenge-detail-title"><h1>{challenge.title}</h1></div>
  <p class="muted">{challenge.description}</p>
  <strong class="challenge-result-count">{people.length.toLocaleString()} matching individuals</strong>
</div>

<section class="section challenge-results" aria-label={`People who have achieved ${challenge.title}`}>
  <div class="section-head"><div><span class="section-kicker">People directory</span><h2>People who have achieved this</h2></div><p>{letterPeople.length.toLocaleString()} people beginning with {selectedLetter || '—'}</p></div>
  {people.length ? <>
    <nav class="achievement-letters" aria-label="Filter people by first letter">
      {letters.map((value) => <a class:list={{ selected: value === selectedLetter }} href={letterUrl(value)}>{value}</a>)}
    </nav>
    {letterPeople.length ? <div class="directory-table challenge-people-directory">
      <div class="directory-row directory-header" aria-hidden="true"><span>Name</span><span>Endorsements</span><span>Endorsers</span><span>POVS Achievements</span><span>Evidence mix</span></div>
      {letterPeople.map((person) => <a class="directory-row" href={sitePath(`/individuals/${encodeURIComponent(person.slug)}/`)}>
        <span class="directory-name"><strong>{person.name}</strong></span>
        <span class="directory-number directory-endorsements">{person.endorsements.toLocaleString()}</span>
        <span class="directory-number directory-endorsers">{person.endorsers.toLocaleString()}</span>
        <span class="directory-number directory-achievements">{person.achievements.toLocaleString()}<small>{person.achievements === 1 ? 'achievement' : 'achievements'}</small></span>
        <span class="directory-mix"><EvidenceMix counts={person.evidenceCounts} /></span>
      </a>)}
    </div> : <div class="empty-state"><strong>No individuals begin with {selectedLetter}.</strong></div>}
  </> : <div class="empty-state"><strong>No matching individuals found in the current dataset.</strong><span>This achievement remains available as the catalogue grows.</span></div>}
</section>
