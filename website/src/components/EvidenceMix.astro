---
import { bands, bandLabels, type EvidenceCounts } from '../lib/records';
interface Props { counts: EvidenceCounts; interactive?: boolean; profileSummary?: boolean }
const { counts, interactive = false, profileSummary = false } = Astro.props;
const total = Object.values(counts).reduce((sum, count) => sum + count, 0);
const tooltipFor = (band: typeof bands[number]) => {
  const count = counts[band];
  const record = count === 1 ? 'record' : 'records';
  const qualifier = band === 'observable'
    ? 'independently observable'
    : band === 'independently-reviewed'
      ? 'independently reviewed'
      : 'indirect';
  return `${count} ${qualifier} ${record} evidence of competence`;
};
---
<span class:list={['level-stack', { 'level-stack-interactive': interactive }]} role="group" aria-label="Evidence mix">
  {interactive
    ? bands.filter((band) => counts[band] > 0).map((band) => <button type="button" class={`level-segment level-${band}`} style={`width:${total ? counts[band] / total * 100 : 0}%`} aria-label={tooltipFor(band)}>
        <span class="level-stack-tooltip" role="tooltip">{tooltipFor(band)}</span>
      </button>)
    : bands.map((band) => <i class={`level-${band}`} style={`width:${total ? counts[band] / total * 100 : 0}%`}></i>)}
</span>
<span class:list={['level-stack-labels', { 'profile-evidence-labels': profileSummary }]}>
  {profileSummary
    ? <><span class="profile-evidence-kind profile-evidence-kind-indirect">{counts.indirect} {counts.indirect === 1 ? 'public organization credit' : 'public organization credits'}</span><span class="profile-evidence-kind profile-evidence-kind-observable">{counts.observable} publicly observable {counts.observable === 1 ? 'record' : 'records'}</span><span class="profile-evidence-kind profile-evidence-kind-reviewed">{counts['independently-reviewed']} independently reviewed {counts['independently-reviewed'] === 1 ? 'record' : 'records'}</span></>
    : bands.map(band => <b>{bandLabels[band]}: {counts[band]}</b>)}
</span>
