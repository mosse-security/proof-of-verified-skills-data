---
import EvidenceMix from '../../components/EvidenceMix.astro';
import Base from '../../layouts/Base.astro';
import { listProfiles } from '../../lib/records';
import { sitePath } from '../../lib/site';

const people = listProfiles()
  .sort((a, b) => b.achievements - a.achievements || b.endorsements - a.endorsements || a.name.localeCompare(b.name))
  .slice(0, 100);
---

<Base home title="Top POVS Achievements | Proof of Verified Skills">
  <div class="directory-intro directory-intro-large domain-intro">
    <span class="section-kicker">Achievement leaders</span>
    <h1>Top POVS Achievements</h1>
    <p class="muted">The top 100 individuals ranked by the number of POVS achievements they have earned.</p>
  </div>

  <section class="directory-table" aria-label="Top POVS Achievements">
    <div class="directory-row directory-header" aria-hidden="true"><span>Name</span><span>POVS Achievements</span><span>Endorsements</span><span>Assessors</span><span>Evidence mix</span></div>
    {people.map((person, index) => <a class="directory-row" href={sitePath(`/individuals/${encodeURIComponent(person.slug)}/`)}><span class="directory-name"><strong><span class="directory-rank">{index + 1}</span>{person.name}</strong></span><span class="directory-number directory-achievements">{person.achievements.toLocaleString()}<small>{person.achievements === 1 ? 'achievement' : 'achievements'}</small></span><span class="directory-number directory-endorsements">{person.endorsements.toLocaleString()}</span><span class="directory-number directory-endorsers">{person.endorsers.toLocaleString()}</span><span class="directory-mix"><EvidenceMix counts={person.evidenceCounts} /></span></a>)}
  </section>
</Base>
