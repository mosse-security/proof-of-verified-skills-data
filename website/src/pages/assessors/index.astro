---
import Base from '../../layouts/Base.astro';
import { listProfiles } from '../../lib/records';
import { sitePath } from '../../lib/site';
const people = listProfiles();
const assessorMap = new Map<string, string>();
people.forEach((person) => Object.entries(person.assessorNames).forEach(([id, name]) => assessorMap.set(id, name)));
const assessors = [...assessorMap.entries()].sort((a, b) => a[1].localeCompare(b[1]));
const individualCount = (assessorId: string) => people.filter((person) => person.assessorIds.includes(assessorId)).length;
---
<Base home title="Assessors | Proof of Verified Skills">
  <div class="directory-intro domain-intro"><h1>Search by assessor</h1><p class="muted">Choose an assessor to see the people and endorsements they recognize.</p></div>
  <section class="directory-table assessor-table" aria-label="Assessors">
    <div class="assessor-row assessor-header" aria-hidden="true"><span>Assessor</span><span>Individuals endorsed</span></div>
    {assessors.map(([assessorId, assessor]) => <a class="assessor-row" href={sitePath(`/assessors/${assessorId.toLocaleLowerCase()}/`)}><strong>{assessor}</strong><span>{individualCount(assessorId).toLocaleString()} individuals <b>→</b></span></a>)}
  </section>
</Base>
