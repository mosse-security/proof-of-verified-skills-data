---
import EvidenceMix from '../../components/EvidenceMix.astro';
import Base from '../../layouts/Base.astro';
import { listProfiles } from '../../lib/records';
import { sitePath } from '../../lib/site';

export function getStaticPaths() {
  const allPeople = listProfiles();
  const assessorMap = new Map<string, string>();
  allPeople.forEach((person) => Object.entries(person.assessorNames).forEach(([id, name]) => assessorMap.set(id, name)));
  return [...assessorMap.entries()].map(([assessorId, assessor]) => ({ params: { assessor: assessorId.toLocaleLowerCase() }, props: { assessorId, assessor } }));
}

const allPeople = listProfiles();
const assessorId = Astro.props.assessorId as string;
const assessor = Astro.props.assessor as string;
const people = allPeople.filter((person) => person.assessorIds.includes(assessorId)).sort((a, b) => b.endorsements - a.endorsements || a.name.localeCompare(b.name));
---
<Base home title={`${assessor} Endorsements | Vetted Cyber Talent`} description={`Explore ${people.length.toLocaleString()} people with public records credited by ${assessor}, including their work and available evidence.`}>
  <div class="directory-intro domain-intro"><span class="section-kicker">Assessor</span><h1>{assessor}</h1><p class="muted">{people.length.toLocaleString()} people recognized by this assessor.</p></div>
  <section class="directory-table" aria-label={`${assessor} individuals`}>
    <div class="directory-row directory-header" aria-hidden="true"><span>Name</span><span>Endorsements</span><span>Endorsers</span><span>POVS Achievements</span><span>Evidence mix</span></div>
    {people.map((person) => <a class="directory-row" data-assessor-row href={sitePath(`/individuals/${encodeURIComponent(person.slug)}/`)}><span class="directory-name"><strong>{person.name}</strong></span><span class="directory-number directory-endorsements">{person.endorsements.toLocaleString()}</span><span class="directory-number directory-endorsers">{person.endorsers.toLocaleString()}</span><span class="directory-number directory-achievements">{person.achievements.toLocaleString()}<small>{person.achievements === 1 ? 'achievement' : 'achievements'}</small></span><span class="directory-mix"><EvidenceMix counts={person.evidenceCounts} /></span></a>)}
  </section>
  <div class="directory-pagination pagination"><button type="button" data-assessor-prev disabled>← Previous</button><span data-assessor-page>Page 1</span><button type="button" data-assessor-next>Next →</button></div>
</Base>

<script>
  const assessorRows = [...document.querySelectorAll('[data-assessor-row]')];
  const pageSize = 100;
  const pages = Math.max(1, Math.ceil(assessorRows.length / pageSize));
  let page = 1;
  const status = document.querySelector('[data-assessor-page]');
  const previous = document.querySelector('[data-assessor-prev]');
  const next = document.querySelector('[data-assessor-next]');
  function renderAssessorPage() {
    assessorRows.forEach((row, index) => { row.hidden = index < (page - 1) * pageSize || index >= page * pageSize; });
    if (status) status.textContent = `Page ${page} of ${pages}`;
    if (previous) previous.disabled = page === 1;
    if (next) next.disabled = page === pages;
  }
  previous?.addEventListener('click', () => { if (page > 1) { page -= 1; renderAssessorPage(); } });
  next?.addEventListener('click', () => { if (page < pages) { page += 1; renderAssessorPage(); } });
  renderAssessorPage();
</script>
