---
import Base from '../../layouts/Base.astro';
import { listProfiles } from '../../lib/records';

export function getStaticPaths() {
  const allPeople = listProfiles();
  return [...new Set(allPeople.flatMap((person) => person.assessors))].map((assessor) => ({ params: { assessor }, props: { assessor } }));
}

const allPeople = listProfiles();
const assessor = Astro.props.assessor as string;
const people = allPeople.filter((person) => person.assessors.includes(assessor)).sort((a, b) => b.endorsements - a.endorsements || a.name.localeCompare(b.name));
const mixTotal = (person: typeof people[number]) => Object.values(person.levelCounts).reduce((sum, count) => sum + count, 0);
const mixWidth = (count: number, person: typeof people[number]) => `${mixTotal(person) ? (count / mixTotal(person)) * 100 : 0}%`;
---
<Base home title={`${assessor} | Proof of Verified Skills`}>
  <div class="directory-intro domain-intro"><span class="section-kicker">Assessor</span><h1>{assessor}</h1><p class="muted">{people.length.toLocaleString()} people recognized by this assessor.</p></div>
  <section class="directory-table" aria-label={`${assessor} individuals`}>
    <div class="directory-row directory-header" aria-hidden="true"><span>Name</span><span>Endorsements</span><span>Endorsers</span><span>Proof mix</span></div>
    {people.map((person) => <a class="directory-row" data-assessor-row href={`/individuals/${encodeURIComponent(person.slug)}/`}><span class="directory-name"><strong>{person.name}</strong></span><span class="directory-number directory-endorsements">{person.endorsements.toLocaleString()}</span><span class="directory-number directory-endorsers">{person.endorsers.toLocaleString()}</span><span class="directory-mix"><span class="level-stack" aria-hidden="true"><i class="level-synthetic" style={`width:${mixWidth(person.levelCounts.synthetic, person)}`}></i><i class="level-production" style={`width:${mixWidth(person.levelCounts.productionLike, person)}`}></i><i class="level-expert" style={`width:${mixWidth(person.levelCounts.expert, person)}`}></i><i class="level-unrated" style={`width:${mixWidth(person.levelCounts.unrated, person)}`}></i></span><span class="level-stack-labels"><b>Synthetic: {person.levelCounts.synthetic}</b><b>Production-like: {person.levelCounts.productionLike}</b><b>Expert: {person.levelCounts.expert}</b><b>Unrated: {person.levelCounts.unrated}</b></span></span></a>)}
  </section>
  <div class="directory-pagination pagination"><button type="button" data-assessor-prev disabled>← Previous</button><span data-assessor-page>Page 1</span><button type="button" data-assessor-next>Next →</button></div>
</Base>

<script>
  const assessorRows = [...document.querySelectorAll('[data-assessor-row]')];
  const pageSize = 100;
  const pages = Math.max(1, Math.ceil(assessorRows.length / pageSize));
  let page = 1;
  const status = document.querySelector('[data-assessor-page]');
  const previous = document.querySelector('[data-assessor-prev]');
  const next = document.querySelector('[data-assessor-next]');
  function renderAssessorPage() {
    assessorRows.forEach((row, index) => { row.hidden = index < (page - 1) * pageSize || index >= page * pageSize; });
    if (status) status.textContent = `Page ${page} of ${pages}`;
    if (previous) previous.disabled = page === 1;
    if (next) next.disabled = page === pages;
  }
  previous?.addEventListener('click', () => { if (page > 1) { page -= 1; renderAssessorPage(); } });
  next?.addEventListener('click', () => { if (page < pages) { page += 1; renderAssessorPage(); } });
  renderAssessorPage();
</script>
