---
import Base from '../../layouts/Base.astro';
import AchievementResults from '../../components/AchievementResults.astro';
import { achievementPeople } from '../../lib/achievement-page';
import { getChallenge, listChallenges } from '../../lib/challenges';

export function getStaticPaths() {
  return listChallenges().map((challenge) => ({ params: { slug: challenge.slug } }));
}

const challenge = getChallenge(Astro.params.slug!);
const people = achievementPeople(Astro.params.slug!);
---

<Base home title={`${challenge.title} | POVS Achievements`} description={challenge.description}>
  <AchievementResults challenge={challenge} people={people} />
</Base>
