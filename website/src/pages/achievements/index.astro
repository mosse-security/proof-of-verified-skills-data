---
import Base from '../../layouts/Base.astro';
import { sitePath } from '../../lib/site';
import { listChallenges } from '../../lib/challenges';

const challenges = listChallenges();
const challengeMeta = challenges.map(({ slug, title, band, description, matches }) => ({ slug, title, band, description, count: matches.length }));
const matchingChallenges = challenges.filter((challenge) => challenge.matches.length > 0).length;
const uniquePeople = new Set(challenges.flatMap((challenge) => challenge.matches.map((match) => match.personSlug))).size;
---

<Base home title="POVS Achievements | Proof of Verified Skills" description="Explore real-world cybersecurity achievements and discover professionals who have accomplished them.">
  <div class="directory-intro directory-intro-large challenges-intro">
    <span class="section-kicker">Achievement registry</span>
    <h1>POVS Achievements</h1>
    <p class="muted">Explore real-world cybersecurity achievements and discover professionals who have accomplished them.</p>
  </div>

  <section class="challenge-summary" aria-label="Achievement summary">
    <div><strong>{challenges.length}</strong><span>Total achievements</span></div>
    <div><strong>{matchingChallenges}</strong><span>Achievements with matches</span></div>
    <div><strong>{uniquePeople.toLocaleString()}</strong><span>Unique matching individuals</span></div>
  </section>

  <section class="challenge-catalogue" aria-label="POVS achievements">
    <div class="challenge-table">
      <div class="challenge-table-head"><span>Achievement</span><span>POVS level</span><span>People</span><span aria-hidden="true"></span></div>
      {challengeMeta.map((challenge) => <a class="challenge-row" href={sitePath(`/achievements/${challenge.slug}/`)}>
        <span class="challenge-name"><strong>{challenge.title}</strong><small>{challenge.description}</small></span>
        <span><b class:list={['challenge-band', `challenge-band-${challenge.band.toLocaleLowerCase().replaceAll(' ', '-')}`]}>{challenge.band}</b></span>
        <span class="challenge-count">{challenge.count.toLocaleString()}</span>
        <span class="challenge-arrow" aria-hidden="true">→</span>
      </a>)}
    </div>
  </section>
</Base>
