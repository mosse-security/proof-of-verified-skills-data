---
import EvidenceMix from '../../components/EvidenceMix.astro';
import Base from '../../layouts/Base.astro';
import { challengesForTags } from '../../lib/challenges';
import {
  endorsementDomains,
  formatDomain,
  formatLabel,
  getProfile,
  bands,
  bandLabels,
  countEvidence,
  listProfiles,
  safeExternalUrl,
} from '../../lib/records';

export function getStaticPaths() {
  return listProfiles().map((profile) => ({ params: { slug: profile.slug } }));
}

const slug = Astro.params.slug!;
const person = getProfile(slug);
const achievements = challengesForTags(person.tags);
const endorsements = (person.endorsements ?? []).slice().sort((a, b) => {
  const year = (b.year ?? 0) - (a.year ?? 0);
  return year || bands.indexOf(b['povs-taxonomy'].evidence) - bands.indexOf(a['povs-taxonomy'].evidence);
});
const endorsers = [...new Set(endorsements.map((item) => item.assessor).filter((assessor): assessor is string => Boolean(assessor)))].sort((a, b) => a.localeCompare(b));
const assessorCount = person.stats?.assessors ?? new Set(endorsements.map((item) => item['assessor-id'] || item.assessor)).size;
const counts = countEvidence(endorsements);
const propertyCounts = {
  trusted: endorsements.filter((item) => item['povs-taxonomy'].trusted === true).length,
  production: endorsements.filter((item) => item['povs-taxonomy'].production === true).length,
};
const propertySummary = (property: keyof typeof propertyCounts) => {
  const count = propertyCounts[property];
  const label = property === 'trusted' ? 'Trusted' : 'Production';
  return `${count} ${label.toLowerCase()}`;
};
const propertyTitle = (property: keyof typeof propertyCounts) => {
  const count = propertyCounts[property];
  const label = property === 'trusted' ? 'trusted' : 'production';
  return `${count} ${label} ${count === 1 ? 'record' : 'records'}`;
};
const properties = { trusted: 'Trusted', production: 'Production', competition: 'Competition', verifiable: 'Independently verifiable' } as const;
const propertyKeys = Object.keys(properties) as (keyof typeof properties)[];
const factHelp = {
  trusted: 'Someone relied on this work when making a real decision or taking action.',
  production: 'The work was done on, or later used in, a live production system.',
  competition: 'The work was part of an organised competition.',
  verifiable: 'A reader can inspect enough public material to judge the specific claim.',
  assessor: 'The independent organisation or programme that credited the person.',
  reviewType: 'The process the assessor used to evaluate the work or result.',
  recordType: 'The kind of work or recognition this record describes.',
  cyberDomain: 'The cybersecurity discipline detected from the record.',
  subspecialty: 'A more specific area within the detected cyber domain.',
  date: 'The year reported by the source record.',
} as const;
type DomainSummary = { domain: string; count: number; subspecialties: Map<string, number> };
const domainSummariesByName = new Map<string, DomainSummary>();
for (const endorsement of endorsements) {
  const domains = [...new Set(endorsementDomains(endorsement).filter((domain) => domain !== 'unknown'))];
  for (const domain of domains) {
    const summary = domainSummariesByName.get(domain) ?? { domain, count: 0, subspecialties: new Map<string, number>() };
    summary.count++;
    domainSummariesByName.set(domain, summary);
    for (const subspecialty of new Set(endorsement.subspecialties?.[domain] ?? [])) {
      summary.subspecialties.set(subspecialty, (summary.subspecialties.get(subspecialty) ?? 0) + 1);
    }
  }
}
const domainSummaries = [...domainSummariesByName.values()]
  .sort((left, right) => right.count - left.count || left.domain.localeCompare(right.domain))
  .map((summary) => ({
    ...summary,
    subspecialties: [...summary.subspecialties.entries()]
      .map(([subspecialty, count]) => ({ subspecialty, count }))
      .sort((left, right) => right.count - left.count || left.subspecialty.localeCompare(right.subspecialty)),
  }));
const largestDomainCount = Math.max(...domainSummaries.map((summary) => summary.count), 1);
const titleFor = (item: typeof endorsements[number]) => item.label || item.description || 'Endorsement';
const assessorLabelFor = (assessor: string) => {
  const words = assessor.trim().split(/\s+/);
  return words.length > 4 ? `${words.slice(0, 4).join(' ')}...` : assessor;
};
const hasClassifiedDomain = (item: typeof endorsements[number]) =>
  endorsementDomains(item).some((domain) => !['unknown', 'unclassified'].includes(domain.toLocaleLowerCase()));
const chipClasses = { indirect: 'level-chip-blue', observable: 'level-chip-orange', 'independently-reviewed': 'level-chip-green' };
const reviewTypeLabel = (value: string) =>
  value === 'double_blind' ? 'Double-blind peer review' : formatLabel(value);
const dateFor = (item: typeof endorsements[number]) => item.year ? String(item.year) : 'Date not specified';
const descriptionFor = (item: typeof endorsements[number]) => item.description?.trim();
const criticalityFor = (item: typeof endorsements[number]) => {
  const match = item.subtitle?.match(/Severity:\s*([A-Za-z]+)(?:\s*\(CVSS\s+[^,]+,\s*([0-9.]+)\))?/i);
  if (!match) return undefined;
  return `${formatLabel(match[1])}${match[2] ? ` · CVSS ${match[2]}` : ''}`;
};
const cveTitleFor = (item: typeof endorsements[number]) => item.type === 'vulnerability_discovery' ? item.description?.replace(/\s+/g, ' ').trim() : undefined;
const youtubeEmbedFor = (item: typeof endorsements[number]) => {
  for (const link of item['evidence-links'] ?? []) {
    const value = safeExternalUrl(link.url);
    if (!value) continue;
    const url = new URL(value);
    const host = url.hostname.replace(/^www\./, '').toLocaleLowerCase();
    let videoId: string | null = null;
    if (host === 'youtu.be') videoId = url.pathname.split('/').filter(Boolean)[0] ?? null;
    if (host === 'youtube.com' || host === 'm.youtube.com' || host === 'youtube-nocookie.com') {
      videoId = url.pathname === '/watch' ? url.searchParams.get('v') : url.pathname.match(/^\/(?:embed|shorts|live)\/([^/?#]+)/)?.[1] ?? null;
    }
    if (videoId && /^[A-Za-z0-9_-]{11}$/.test(videoId)) return `https://www.youtube-nocookie.com/embed/${videoId}`;
  }
  return undefined;
};
const contactLinks = (person.contact ?? []).flatMap((contact) => {
  const url = safeExternalUrl(contact.url);
  const email = contact.email?.trim();
  const href = url || (email ? `mailto:${email}` : undefined);
  if (!href) return [];
  const label = contact.label?.trim() || (email ? 'Email' : 'Website');
  const normalized = label.toLowerCase();
  const kind = normalized.includes('linkedin') ? 'linkedin' : normalized.includes('github') ? 'github' : normalized.includes('youtube') || href.includes('youtube.com') || href.includes('youtu.be') ? 'youtube' : normalized.includes('twitter') || normalized === 'x' ? 'twitter' : email ? 'email' : 'website';
  return [{ href, label, kind, external: Boolean(url) }];
});
const profileImageUrl = safeExternalUrl(person.image?.url);
---

<Base title={`${person.name} | Proof of Verified Skills`} description={person.biography || `Public endorsement record for ${person.name}.`}>
  <section class="registry-record profile-record">
    <div class="record-header">
      {profileImageUrl && <figure class="profile-photo" data-profile-photo hidden>
        <img src={profileImageUrl} alt={`${person.name} profile`} loading="eager" decoding="async" />
      </figure>}
      <div class="profile-header-content">
        <h1>{person.name}</h1>
        {person.biography && <p>{person.biography}</p>}
        <div class="profile-meta-line">
          <span class="profile-evidence-summary">{endorsements.length} public {endorsements.length === 1 ? 'record' : 'records'} of work, assessed by {assessorCount} independent {assessorCount === 1 ? 'organization' : 'organizations'}.<span class="fact-help profile-evidence-help" tabindex="0" aria-label="POVS does not give people a score. It documents public records of work and the organisation and review process behind each record."><span class="fact-help-icon" aria-hidden="true">?</span><span class="fact-help-tooltip" role="tooltip">POVS does not give people a score. It documents public records of work and the organisation and review process behind each record.</span></span></span>
          {(propertyCounts.trusted > 0 || propertyCounts.production > 0) && <span class="profile-signal-summary" role="group" aria-label="Verified record properties">
            {propertyCounts.trusted > 0 && <span class="property-marker property-marker-trusted" title={propertyTitle('trusted')}>{propertySummary('trusted')}</span>}
            {propertyCounts.production > 0 && <span class="property-marker property-marker-production" title={propertyTitle('production')}>{propertySummary('production')}</span>}
          </span>}
        </div>
        <div class="profile-level-mix"><EvidenceMix counts={counts} interactive /></div>
        {contactLinks.length > 0 && <nav class="contact-row" aria-label={`Contact links for ${person.name}`}>
          {contactLinks.map((contact) => <a class:list={['contact-link', `contact-link-${contact.kind}`]} href={contact.href} title={contact.label} aria-label={`${contact.label} for ${person.name}`} target={contact.external ? '_blank' : undefined} rel={contact.external ? 'noopener noreferrer' : undefined}>
            <span class="contact-icon" aria-hidden="true">
              {contact.kind === 'youtube' ? <svg viewBox="0 0 24 24" role="img"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.8V8.2l6.5 3.8-6.5 3.8Z" /></svg> : contact.kind === 'website' ? <svg viewBox="0 0 24 24" role="img"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.4 2.5 3.6 5.5 3.6 9s-1.2 6.5-3.6 9c-2.4-2.5-3.6-5.5-3.6-9S9.6 5.5 12 3Z" /></svg> : contact.kind === 'linkedin' ? 'in' : contact.kind === 'github' ? 'GH' : contact.kind === 'twitter' ? '𝕏' : '@'}
            </span>
          </a>)}
        </nav>}
      </div>
    </div>
  </section>

  {achievements.length > 0 && <section class="section profile-achievements" aria-labelledby="profile-achievements-title">
    <div class="section-head">
      <h2 id="profile-achievements-title">Achievements</h2>
      <p>{achievements.length} {achievements.length === 1 ? 'achievement' : 'achievements'} obtained.</p>
    </div>
    <div class="profile-achievement-list">
      {achievements.map((achievement) => <div class="profile-achievement">
        <span><strong>{achievement.title}</strong><small>{achievement.description}</small></span>
      </div>)}
    </div>
  </section>}

  <section class="section evidence-section" id="evidence">
    <div class="section-head">
      <h2>Proof of Skills</h2>
      <p>{endorsements.length} matching records.</p>
    </div>
    <div class="evidence-controls">
      <div class="area-pills">
        <button type="button" class="active" data-assessor-filter="all" aria-pressed="true">All Endorsements <span>{endorsements.length}</span></button>
        {endorsers.map((assessor) => <button type="button" title={assessor} data-assessor-filter={assessor} aria-pressed="false">{assessorLabelFor(assessor)} <span>{endorsements.filter((item) => item.assessor === assessor).length}</span></button>)}
      </div>
    </div>
    <div class="evidence-list">
      {endorsements.length ? endorsements.map((item, index) => <button type="button" class="evidence-row" data-open-id={`endorsement-${index}`} data-assessor={item.assessor || ''}>
        <span class="row-main">
          <span class="row-title-line"><strong>{titleFor(item)}</strong>{criticalityFor(item) && <small class={`criticality criticality-${criticalityFor(item)?.split(' ')[0].toLowerCase()}`}>{criticalityFor(item)}</small>}</span>
          {cveTitleFor(item) && <small class="cve-title">{cveTitleFor(item)}</small>}
          <small class="endorser">
            Endorsed by <strong>{item.assessor || 'Assessor not specified'}</strong>{item.reviewType && <> · {reviewTypeLabel(item.reviewType)}</>}
            {(item['povs-taxonomy'].trusted === true || item['povs-taxonomy'].production === true || youtubeEmbedFor(item)) && <span class="property-markers" role="group" aria-label="Record highlights">
              {item['povs-taxonomy'].trusted === true && <span class="property-marker property-marker-trusted">Trusted</span>}
              {item['povs-taxonomy'].production === true && <span class="property-marker property-marker-production">Production</span>}
              {youtubeEmbedFor(item) && <span class="property-marker property-marker-video" title="A video recording is available in this record.">Video available</span>}
            </span>}
          </small>
        </span>
        <span class="evidence-meta">
          <span class:list={['domain-badge', !hasClassifiedDomain(item) && 'domain-badge-unclassified']} title={endorsementDomains(item).map(formatDomain).join(', ') || 'Cyber domain not classified'}>{endorsementDomains(item).length > 1 ? 'Multiple domains' : formatDomain(endorsementDomains(item)[0] || 'Unclassified')}</span>
          <span class="row-context">
            <strong class={`level-chip ${chipClasses[item['povs-taxonomy'].evidence]}`}>{bandLabels[item['povs-taxonomy'].evidence]}</strong>
            <small>{dateFor(item)}</small>
          </span>
        </span>
      </button>) : <div class="empty-state"><strong>No proof records match this view.</strong><span>There are no public endorsements for this individual yet.</span></div>}
      {endorsements.length > 0 && <div class="empty-state" data-filter-empty hidden><strong>No proof records in this domain.</strong><span>Choose another domain to see more evidence.</span></div>}
    </div>
  </section>

  {domainSummaries.length > 0 && <section class="section cyber-domains" aria-labelledby="cyber-domains-title">
    <div class="section-head cyber-domains-head">
      <div><h2 id="cyber-domains-title">Cyber Domains</h2><p>Domains and subspecialties detected across this profile’s endorsements.</p></div>
      <p>{domainSummaries.length} {domainSummaries.length === 1 ? 'domain' : 'domains'} identified.</p>
    </div>
    <div class="domain-chart">
      {domainSummaries.map((summary) => <div class="domain-chart-group">
        <div class="domain-chart-row">
          <strong>{formatDomain(summary.domain)}</strong>
          <span class="domain-bar" aria-label={`${summary.count} ${summary.count === 1 ? 'record' : 'records'}`}><span style={`width:${summary.count / largestDomainCount * 100}%`}></span></span>
          <small>{summary.count}</small>
        </div>
        {summary.subspecialties.length > 0 && <div class="domain-subchart">
          {summary.subspecialties.map((subspecialty) => <div class="domain-subchart-row">
            <span>{formatDomain(subspecialty.subspecialty)}</span>
            <span class="subspecialty-bar" aria-label={`${subspecialty.count} ${subspecialty.count === 1 ? 'record' : 'records'}`}><span style={`width:${subspecialty.count / summary.count * 100}%`}></span></span>
            <small>{subspecialty.count}</small>
          </div>)}
        </div>}
      </div>)}
    </div>
  </section>}

  {endorsements.length > 0 && <details class="profile-verification-note" aria-label="Questions about these records">
    <summary><span>About the evidence</span><b>Questions and corrections</b></summary>
    <div class="profile-verification-note-panel">
      <details>
        <summary>What do the evidence bands mean?</summary>
        <p>Indirect evidence credits someone with an achievement. Observable work is available to inspect. Independently reviewed work underwent formal assessment.</p>
      </details>
      <details>
        <summary>Is this a subjective vetting score?</summary>
        <p>No. POVS does not give people a score or decide whether someone is “good” at cybersecurity. It documents public records of work—such as peer-reviewed papers, conference presentations, or named vulnerability credits—and identifies the organisation and review process behind each record.</p>
      </details>
      <details>
        <summary>How can I correct or upgrade the record?</summary>
        <p>If you know of a recording or other public evidence, or can help us verify that work was used in production, please <a href="mailto:contact@vetted-cyber-talent.com">contact us</a>. Verified evidence may allow us to upgrade the record.</p>
      </details>
    </div>
  </details>}

  <div class="drawer-scrim" data-close-drawer></div>
  <aside class="drawer" aria-hidden="true" aria-label="Endorsement details">
    <div class="drawer-head">
      <div><span>Proof of skills</span><h2 data-drawer-title>Endorsement</h2><p>Public evidence record</p></div>
      <button type="button" class="drawer-close" data-close-drawer aria-label="Close">×</button>
    </div>
    <div class="drawer-body">
      {endorsements.map((item, index) => <article class="drawer-record" data-panel-id={`endorsement-${index}`} hidden>
        <div class="drawer-meta">
          {item.subtitle && <p class="drawer-subtitle"><span>{item.type === 'presentation' ? 'Conference' : item.type === 'vulnerability_discovery' ? 'Criticality' : 'Context'}</span>{item.subtitle}</p>}
          <p class="drawer-byline">Endorsed by <strong>{item.assessor || 'Assessor not specified'}</strong></p>
        </div>
        {youtubeEmbedFor(item) && <section class="video-evidence" aria-label="Video evidence"><iframe src={youtubeEmbedFor(item)} data-video-src={youtubeEmbedFor(item)} title={`Video evidence for ${titleFor(item)}`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></section>}
        {descriptionFor(item) && descriptionFor(item) !== titleFor(item).trim() && <section class="record-description"><h3>{item.type === 'presentation' ? 'Abstract' : item.type === 'vulnerability_discovery' ? 'Details' : 'Description'}</h3><p>{descriptionFor(item)}</p></section>}
        <section class="plain-explainer"><div><h3>{bandLabels[item['povs-taxonomy'].evidence]}</h3><p>{item['povs-taxonomy'].explanation}</p></div></section>
        {(safeExternalUrl(item.url) || (item['evidence-links']?.length ?? 0) > 0) && <section class="drawer-section"><h4>Source records</h4><div class="external-links">
          {safeExternalUrl(item.url) && <a href={safeExternalUrl(item.url)} target="_blank" rel="noopener noreferrer"><span>Source</span><strong>{item.url}</strong></a>}
          {item['evidence-links']?.filter((link) => safeExternalUrl(link.url) !== safeExternalUrl(item.url)).map((link) => safeExternalUrl(link.url) && <a href={safeExternalUrl(link.url)} target="_blank" rel="noopener noreferrer"><span>Proof</span><strong>{link.title || link.url}</strong></a>)}
        </div></section>}
        <h3 class="facts-heading">Record details</h3>
        <dl class="facts">
          {propertyKeys.map(key => <div><dt>{properties[key]}<span class="fact-help" tabindex="0" aria-label={factHelp[key]}><span class="fact-help-icon" aria-hidden="true">?</span><span class="fact-help-tooltip" role="tooltip">{factHelp[key]}</span></span></dt><dd>{item['povs-taxonomy'][key] === 'unknown' ? 'Unknown' : item['povs-taxonomy'][key] ? 'Yes' : 'No'}</dd></div>)}
          <div><dt>Assessor<span class="fact-help" tabindex="0" aria-label={factHelp.assessor}><span class="fact-help-icon" aria-hidden="true">?</span><span class="fact-help-tooltip" role="tooltip">{factHelp.assessor}</span></span></dt><dd>{item.assessor || 'Not specified'}</dd></div>
          <div><dt>Review type<span class="fact-help" tabindex="0" aria-label={factHelp.reviewType}><span class="fact-help-icon" aria-hidden="true">?</span><span class="fact-help-tooltip" role="tooltip">{factHelp.reviewType}</span></span></dt><dd>{item.reviewType ? reviewTypeLabel(item.reviewType) : 'Not specified'}</dd></div>
          <div><dt>Record type<span class="fact-help" tabindex="0" aria-label={factHelp.recordType}><span class="fact-help-icon" aria-hidden="true">?</span><span class="fact-help-tooltip" role="tooltip">{factHelp.recordType}</span></span></dt><dd>{formatLabel(item.type)}</dd></div>
          <div><dt>Cyber domain<span class="fact-help" tabindex="0" aria-label={factHelp.cyberDomain}><span class="fact-help-icon" aria-hidden="true">?</span><span class="fact-help-tooltip" role="tooltip">{factHelp.cyberDomain}</span></span></dt><dd>{endorsementDomains(item).map(formatDomain).join(', ') || 'Not classified'}</dd></div>
          <div><dt>Sub-specialty<span class="fact-help" tabindex="0" aria-label={factHelp.subspecialty}><span class="fact-help-icon" aria-hidden="true">?</span><span class="fact-help-tooltip" role="tooltip">{factHelp.subspecialty}</span></span></dt><dd>{Object.values(item.subspecialties ?? {}).flat().map(formatDomain).join(', ') || 'Not specified'}</dd></div>
          <div><dt>Date<span class="fact-help" tabindex="0" aria-label={factHelp.date}><span class="fact-help-icon" aria-hidden="true">?</span><span class="fact-help-tooltip" role="tooltip">{factHelp.date}</span></span></dt><dd>{dateFor(item)}</dd></div>
        </dl>
      </article>)}
    </div>
  </aside>
</Base>

<script>
  const drawer = document.querySelector('.drawer');
  const scrim = document.querySelector('.drawer-scrim');
  const title = document.querySelector('[data-drawer-title]');
  const rows = document.querySelectorAll('[data-open-id]');
  const closeElements = document.querySelectorAll('[data-close-drawer]');
  const filterButtons = document.querySelectorAll('[data-assessor-filter]');
  const filterEmpty = document.querySelector('[data-filter-empty]');

  filterButtons.forEach((button) => button.addEventListener('click', (event) => {
    event.preventDefault();
    const assessor = button.getAttribute('data-assessor-filter') || 'all';
    let visible = 0;
    filterButtons.forEach((item) => {
      const active = item === button;
      item.classList.toggle('active', active);
      item.setAttribute('aria-pressed', String(active));
    });
    rows.forEach((row) => {
      const rowAssessor = row.getAttribute('data-assessor') || '';
      const show = assessor === 'all' || rowAssessor === assessor;
      row.hidden = !show;
      if (show) visible += 1;
    });
    if (filterEmpty) filterEmpty.hidden = visible > 0;
  }));

  function closeDrawer() {
    document.querySelectorAll('.video-evidence iframe').forEach((element) => {
      if (element instanceof HTMLIFrameElement) element.removeAttribute('src');
    });
    drawer?.classList.remove('open');
    scrim?.classList.remove('open');
    drawer?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('drawer-open');
    document.querySelectorAll('[data-panel-id]').forEach((panel) => { panel.hidden = true; });
  }

  rows.forEach((row) => row.addEventListener('click', () => {
    const id = row.getAttribute('data-open-id');
    const panel = id ? document.querySelector(`[data-panel-id="${id}"]`) : null;
    if (!panel || !drawer || !scrim) return;
    document.querySelectorAll('[data-panel-id]').forEach((item) => { item.hidden = item !== panel; });
    panel.querySelectorAll('.video-evidence iframe').forEach((element) => {
      if (element instanceof HTMLIFrameElement && !element.getAttribute('src') && element.dataset.videoSrc) {
        element.src = element.dataset.videoSrc;
      }
    });
    if (title) title.textContent = row.querySelector('strong')?.textContent || 'Endorsement';
    drawer.classList.add('open');
    scrim.classList.add('open');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.classList.add('drawer-open');
  }));
  closeElements.forEach((element) => element.addEventListener('click', closeDrawer));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeDrawer(); });
</script>

<script>
  document.querySelectorAll('[data-profile-photo]').forEach((figure) => {
    const image = figure.querySelector('img');
    if (!(image instanceof HTMLImageElement)) return;
    const header = figure.closest('.record-header');
    const show = () => {
      if (image.naturalWidth > 0) {
        header?.classList.add('profile-header-with-image');
        figure.removeAttribute('hidden');
      }
    };
    image.addEventListener('load', show, { once: true });
    image.addEventListener('error', () => {
      figure.remove();
      header?.classList.remove('profile-header-with-image');
    }, { once: true });
    if (image.complete) show();
  });
</script>
