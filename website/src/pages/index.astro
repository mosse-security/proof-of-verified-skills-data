---
import Base from '../layouts/Base.astro';
import { sitePath } from '../lib/site';
---
<Base home title="Vetted Cyber Talent | Public Cybersecurity Work Records" description="Explore public records of cybersecurity research, conference presentations, vulnerability discoveries and other work, with links to their sources and review processes.">
  <section class="simple-home">
    <h1>Discover vetted cyber professionals</h1>
    <form class="homepage-search" action={sitePath('/search/')} method="get">
      <label for="homepage-search-input">Search the registry</label>
      <div class="homepage-search-row">
        <input id="homepage-search-input" name="q" type="search" placeholder="Search by name, assessor, endorsement, or domain" autocomplete="off" />
        <button type="submit">Search</button>
      </div>
    </form>
    <div class="simple-home-actions">
      <a class="simple-home-card simple-home-card-primary" href={sitePath('/directory/')}><span class="simple-home-icon">⌕</span><strong>Find a person</strong><small>Search the directory by name.</small><b>Search by name →</b></a>
      <a class="simple-home-card" href={sitePath('/domains/')}><span class="simple-home-icon">◈</span><strong>Browse by cyber domain</strong><small>Choose a cybersecurity specialty.</small><b>Search by cyber domain →</b></a>
      <a class="simple-home-card" href={sitePath('/countries/')}><span class="simple-home-icon">◎</span><strong>Search by country</strong><small>Explore public records connected to assessors around the world.</small><b>Explore countries →</b></a>
      <a class="simple-home-card" href={sitePath('/assessors/')}><span class="simple-home-icon">◎</span><strong>Search by assessor</strong><small>Find people recognized by a specific assessor.</small><b>Search by assessor →</b></a>
      <a class="simple-home-card" href={sitePath('/hall-of-fame/')}><span class="simple-home-icon">★</span><strong>Hall of Fame</strong><small>See the top 1,000 in each domain.</small><b>See the leaders →</b></a>
      <a class="simple-home-card" href={sitePath('/most-vetted/')}><span class="simple-home-icon">✦</span><strong>The Most Vetted</strong><small>Find the people reviewed by the most assessors.</small><b>See the most vetted →</b></a>
      <a class="simple-home-card" href={sitePath('/most-endorsements/')}><span class="simple-home-icon">◆</span><strong>The Most Endorsements</strong><small>See the top 1,000 people by endorsement count.</small><b>See the leaders →</b></a>
      <a class="simple-home-card" href={sitePath('/most-achievements/')}><span class="simple-home-icon">✧</span><strong>Top POVS Achievements</strong><small>See the 100 individuals with the most POVS achievements.</small><b>See the achievement leaders →</b></a>
      <a class="simple-home-card" href={sitePath('/achievements/')}><span class="simple-home-icon">◇</span><strong>POVS Achievements</strong><small>Explore real-world cybersecurity achievements.</small><b>Explore achievements →</b></a>
      <a class="simple-home-card simple-home-card-contribute" href={sitePath('/contribute/')}><span class="simple-home-icon">＋</span><strong>Contribute</strong><small>Help improve this public, open-source record.</small><b>Learn how to contribute →</b></a>
    </div>
  </section>
</Base>
