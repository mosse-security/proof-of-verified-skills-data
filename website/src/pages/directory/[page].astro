---
import EvidenceMix from '../../components/EvidenceMix.astro';
import Base from '../../layouts/Base.astro';
import { listProfiles } from '../../lib/records';
import { sitePath } from '../../lib/site';

export function getStaticPaths() {
  const letters = Array.from({ length: 26 }, (_, index) => String.fromCharCode(65 + index));
  return letters.map((letter) => ({ params: { page: letter.toLocaleLowerCase() } }));
}

const letters = Array.from({ length: 26 }, (_, index) => String.fromCharCode(65 + index));
const letter = (Astro.params.page ?? 'A').toLocaleUpperCase();
const people = listProfiles().filter((person) => person.name.trim().charAt(0).toLocaleUpperCase() === letter);
---
<Base title={`Cybersecurity Professionals: ${letter} | Vetted Cyber Talent`} description={`Browse cybersecurity professionals whose names start with ${letter}. Explore public records, endorsing organizations, and review processes.`}>
  <div class="directory-intro"><h1>Individual directory</h1></div>
  <nav class="alphabet-nav" aria-label="Search by first name">{letters.map((item) => <a class:active={item === letter} aria-current={item === letter ? 'page' : undefined} href={sitePath(`/directory/${item.toLocaleLowerCase()}/`)}>{item}</a>)}</nav>
  <section class="directory-table" aria-label={`Individuals starting with ${letter}`}>
    <div class="directory-row directory-header" aria-hidden="true"><span>Name</span><span>Endorsements</span><span>Endorsers</span><span>POVS Achievements</span><span>Evidence mix</span></div>
    {people.map((person) => <a class="directory-row" href={sitePath(`/individuals/${encodeURIComponent(person.slug)}/`)}><span class="directory-name"><strong>{person.name}</strong></span><span class="directory-number directory-endorsements">{person.endorsements.toLocaleString()}</span><span class="directory-number directory-endorsers">{person.endorsers.toLocaleString()}</span><span class="directory-number directory-achievements">{person.achievements.toLocaleString()}<small>{person.achievements === 1 ? 'achievement' : 'achievements'}</small></span><span class="directory-mix"><EvidenceMix counts={person.evidenceCounts} /></span></a>)}
    {!people.length && <div class="directory-empty">No individuals found for this letter.</div>}
  </section>
</Base>
