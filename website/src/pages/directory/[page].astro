---
import Base from '../../layouts/Base.astro';
import { listProfiles } from '../../lib/records';

export function getStaticPaths() {
  const letters = Array.from({ length: 26 }, (_, index) => String.fromCharCode(65 + index));
  return letters.map((letter) => ({ params: { page: letter } }));
}

const letters = Array.from({ length: 26 }, (_, index) => String.fromCharCode(65 + index));
const letter = (Astro.params.page ?? 'A').toLocaleUpperCase();
const people = listProfiles().filter((person) => person.name.trim().charAt(0).toLocaleUpperCase() === letter);
const mixTotal = (person: typeof people[number]) => Object.values(person.levelCounts).reduce((sum, count) => sum + count, 0);
const mixWidth = (count: number, person: typeof people[number]) => `${mixTotal(person) ? (count / mixTotal(person)) * 100 : 0}%`;
---
<Base title={`${letter} individuals | Proof of Verified Skills`}>
  <div class="directory-intro"><h1>Individual directory</h1></div>
  <nav class="alphabet-nav" aria-label="Search by first name">{letters.map((item) => <a class:active={item === letter} aria-current={item === letter ? 'page' : undefined} href={`/directory/${item}/`}>{item}</a>)}</nav>
  <section class="directory-table" aria-label={`Individuals starting with ${letter}`}>
    <div class="directory-row directory-header" aria-hidden="true"><span>Name</span><span>Endorsements</span><span>Endorsers</span><span>Proof mix</span></div>
    {people.map((person) => <a class="directory-row" href={`/individuals/${encodeURIComponent(person.slug)}/`}><span class="directory-name"><strong>{person.name}</strong></span><span class="directory-number directory-endorsements">{person.endorsements.toLocaleString()}</span><span class="directory-number directory-endorsers">{person.endorsers.toLocaleString()}</span><span class="directory-mix"><span class="level-stack" aria-hidden="true"><i class="level-synthetic" style={`width:${mixWidth(person.levelCounts.synthetic, person)}`}></i><i class="level-production" style={`width:${mixWidth(person.levelCounts.productionLike, person)}`}></i><i class="level-expert" style={`width:${mixWidth(person.levelCounts.expert, person)}`}></i><i class="level-unrated" style={`width:${mixWidth(person.levelCounts.unrated, person)}`}></i></span><span class="level-stack-labels"><b>Synthetic: {person.levelCounts.synthetic}</b><b>Production-like: {person.levelCounts.productionLike}</b><b>Expert: {person.levelCounts.expert}</b><b>Unrated: {person.levelCounts.unrated}</b></span></span></a>)}
    {!people.length && <div class="directory-empty">No individuals found for this letter.</div>}
  </section>
</Base>
