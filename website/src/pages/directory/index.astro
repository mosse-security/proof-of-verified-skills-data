---
import Base from '../../layouts/Base.astro';
import { listProfiles } from '../../lib/records';
import { sitePath } from '../../lib/site';
const people = listProfiles().filter((person) => person.name.trim().charAt(0).toLocaleUpperCase() === 'A');
const letters = Array.from({ length: 26 }, (_, index) => String.fromCharCode(65 + index));
const mixTotal = (person: typeof people[number]) => Object.values(person.levelCounts).reduce((sum, count) => sum + count, 0);
const mixWidth = (count: number, person: typeof people[number]) => `${mixTotal(person) ? (count / mixTotal(person)) * 100 : 0}%`;
---
<Base title="Individual directory | Proof of Verified Skills">
  <div class="directory-intro"><h1>Individual directory</h1></div>
  <nav class="alphabet-nav" aria-label="Search by first name">{letters.map((letter) => <a class:active={letter === 'A'} aria-current={letter === 'A' ? 'page' : undefined} href={sitePath(`/directory/${letter.toLocaleLowerCase()}/`)}>{letter}</a>)}</nav>
  <section class="directory-table" aria-label="Individuals starting with A">
    <div class="directory-row directory-header" aria-hidden="true"><span>Name</span><span>Endorsements</span><span>Endorsers</span><span>POVS Achievements</span><span>Proof mix</span></div>
    {people.map((person) => <a class="directory-row" href={sitePath(`/individuals/${encodeURIComponent(person.slug)}/`)}><span class="directory-name"><strong>{person.name}</strong></span><span class="directory-number directory-endorsements">{person.endorsements.toLocaleString()}</span><span class="directory-number directory-endorsers">{person.endorsers.toLocaleString()}</span><span class="directory-number directory-achievements">{person.achievements.toLocaleString()}<small>{person.achievements === 1 ? 'achievement' : 'achievements'}</small></span><span class="directory-mix"><span class="level-stack" aria-hidden="true"><i class="level-synthetic" style={`width:${mixWidth(person.levelCounts.synthetic, person)}`}></i><i class="level-production" style={`width:${mixWidth(person.levelCounts.productionLike, person)}`}></i><i class="level-expert" style={`width:${mixWidth(person.levelCounts.expert, person)}`}></i><i class="level-unrated" style={`width:${mixWidth(person.levelCounts.unrated, person)}`}></i></span><span class="level-stack-labels"><b>Synthetic: {person.levelCounts.synthetic}</b><b>Production-like: {person.levelCounts.productionLike}</b><b>Expert: {person.levelCounts.expert}</b><b>Not Verified: {person.levelCounts.unrated}</b></span></span></a>)}
  </section>
</Base>
