---
import Base from '../../layouts/Base.astro';
import { formatDomain, listProfiles } from '../../lib/records';
const people = listProfiles();
const domains = [...new Set(people.flatMap((person) => person.domains))].sort((a, b) => formatDomain(a).localeCompare(formatDomain(b)));
---
<Base home title="Hall of Fame | Proof of Verified Skills">
  <div class="directory-intro"><span class="section-kicker">Recognized leaders</span><h1>Hall of Fame</h1><p class="muted">Choose a cyber domain to see its top 1,000 people by endorsement count.</p></div>
  <div class="simple-link-grid">{domains.map((domain) => <a class="simple-link-card" href={`/hall-of-fame/${encodeURIComponent(domain)}/`}><strong>{formatDomain(domain)}</strong><span>Top 1,000 people <b>→</b></span></a>)}</div>
</Base>
